{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build:broker",
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/credentials.ts": {
      "maxDuration": 30
    },
    "api/artifacts.ts": {
      "maxDuration": 30
    },
    "api/model.ts": {
      "maxDuration": 60
    },
    "api/tracker.ts": {
      "maxDuration": 60
    },
    "api/tracker-credentials.ts": {
      "maxDuration": 30
    },
    "api/execute.ts": {
      "maxDuration": 300
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  }
}

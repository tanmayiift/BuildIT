          "uid": "afwt2cuzwjf9cd",
          "title": "BuildIT telemetry silent",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "grafanacloud-prom",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "grafanacloud-prom"
                },
                "editorMode": "code",
                "expr": "max(absent_over_time(buildit_operations_total[15m]) or vector(0))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",

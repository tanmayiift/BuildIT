      ]
    },
    {
      "uid": "ab2241ca-678e-5b45-bad0-cb412c516183",
      "title": "BuildITStaleCheck",
      "for": "0s",
      "folderUID": "efy7a6war64n4d",
      "ruleGroup": "buildit-release",
      "expressions": [
        "sum(increase(buildit_failures_total{buildit_operation=\"review.stale_check\"}[5m])) > 0"

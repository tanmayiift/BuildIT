# Public client configuration
#
# NEXT_PUBLIC_CONVEX_URL is baked into the web build, so it decides which Convex deployment every
# browser page reads. Next loads it from `apps/web/.env.local` - the app directory, not this file's
# directory - and a shell variable overrides that file. CI and the release workflow set it at job
# level, which is why CI can be green on a checkout whose local copy points somewhere else.
#
# /proof is the only public page that reads live data, and it needs a deployment that actually
# serves `publicProof:summary`. A development deployment with nothing pushed to it does not, and
# /proof will render its error boundary. `pnpm test:e2e` probes this before it builds and says so.
NEXT_PUBLIC_CONVEX_URL=https://example-deployment.convex.cloud
NEXT_PUBLIC_BROKER_URL=https://buildit-content-broker.vercel.app

# Server-only GitHub App configuration
GITHUB_APP_ID=000000
GITHUB_APP_CLIENT_ID=Iv1.example
GITHUB_APP_CLIENT_SECRET=replace-in-provider-dashboard
GITHUB_APP_PRIVATE_KEY_BASE64=replace-in-provider-dashboard
GITHUB_WEBHOOK_SECRET=replace-in-provider-dashboard

# Server-only encryption and artifact configuration
AWS_REGION=eu-west-1
AWS_KMS_KEY_ID=alias/buildit-example
AWS_ARTIFACT_BUCKET=buildit-example-private

# Server-only sandbox configuration
VERCEL_TEAM_ID=team_example
VERCEL_PROJECT_ID=project_example

# Model keys are entered by each organization through BuildIT. Never place a
# customer's Anthropic or OpenAI key in this shared deployment file.

# Grafana Cloud service account token with alert-rule write access. Used by `pnpm alerts:provision`
# to push observability/alerts.yml to the stack, and by `pnpm alerts:verify` - which CI runs, and
# which fails when this is unset - to read the deployed rules back and compare them. It was never
# documented here, which is part of why nobody noticed the rules had never been deployed.
BUILDIT_GRAFANA_SERVICE_ACCOUNT_TOKEN=

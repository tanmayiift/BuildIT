{
  "id": null,
  "uid": "buildit-overview",
  "title": "BuildIT product and platform health",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "tags": ["buildit", "source-free"],
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "buildit_prometheus",
        "label": "BuildIT metrics source",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": true, "text": "grafanacloud-peacefulbumblebee2324-prom", "value": "grafanacloud-prom"},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Operation rate", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(buildit_operations_total[5m]))"}], "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0}},
    {"id": 2, "type": "stat", "title": "Service failure ratio", "description": "Actual failed operations divided by succeeded plus failed operations. Intentional blocked requests are tracked by separate safety alerts.", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "(sum(rate(buildit_failures_total{buildit_outcome=\"failed\"}[10m])) or vector(0)) / clamp_min((sum(rate(buildit_operations_total{buildit_outcome=~\"succeeded|failed\"}[10m])) or vector(0)), 0.001)"}], "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "p95 latency by operation", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, buildit_operation) (rate(buildit_operation_duration_milliseconds_bucket[10m])))", "legendFormat": "{{buildit_operation}}"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 4, "type": "timeseries", "title": "Review stages and outcomes", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "sum by (buildit_stage, buildit_outcome) (rate(buildit_operations_total[5m]))", "legendFormat": "{{buildit_stage}} · {{buildit_outcome}}"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 5, "type": "timeseries", "title": "Provider and runner failures", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "sum by (buildit_operation) (increase(buildit_failures_total{buildit_operation=~\"model.invoke|sandbox.execute|sandbox.cleanup\"}[1h]))", "legendFormat": "{{buildit_operation}}"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}},
    {"id": 6, "type": "timeseries", "title": "Activation funnel", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "sum by (buildit_operation, buildit_outcome) (increase(buildit_operations_total{buildit_operation=~\"activation.*\"}[1h]))", "legendFormat": "{{buildit_operation}} · {{buildit_outcome}}"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}},
    {"id": 7, "type": "timeseries", "title": "Human decisions", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "sum by (buildit_outcome) (increase(buildit_operations_total{buildit_operation=~\"activation.decision|review.decision\"}[1h]))", "legendFormat": "{{buildit_outcome}}"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}},
    {"id": 8, "type": "timeseries", "title": "GitHub delivery", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "sum by (buildit_operation, buildit_outcome) (increase(buildit_operations_total{buildit_operation=~\"github.*\"}[1h]))", "legendFormat": "{{buildit_operation}} · {{buildit_outcome}}"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}},
    {"id": 9, "type": "timeseries", "title": "Artifact deletion backlog", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "max(buildit_snapshot{buildit_measurement=\"expired_artifact_backlog\"})"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}},
    {"id": 10, "type": "timeseries", "title": "Queue and capacity", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "max by (buildit_measurement) (buildit_snapshot{buildit_measurement=~\"queue_depth|active_reviews|capacity_utilization\"})", "legendFormat": "{{buildit_measurement}}"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}},
    {"id": 11, "type": "stat", "title": "Hourly provider cost", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "max(buildit_snapshot{buildit_measurement=\"model_cost_usd_hour\"})"}], "gridPos": {"h": 8, "w": 6, "x": 12, "y": 32}},
    {"id": 12, "type": "stat", "title": "Effective LOC delivered", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "max(buildit_snapshot{buildit_measurement=\"effective_loc_delivered_hour\"})"}], "gridPos": {"h": 8, "w": 6, "x": 18, "y": 32}},
    {"id": 13, "type": "timeseries", "title": "Security boundary outcomes", "datasource": {"uid": "$buildit_prometheus"}, "targets": [{"refId": "A", "expr": "sum by (buildit_operation, buildit_outcome) (increase(buildit_operations_total{buildit_operation=~\"webhook.verify|autofix.loop_guard|review.stale_check|artifact.delete\"}[1h]))", "legendFormat": "{{buildit_operation}} · {{buildit_outcome}}"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40}},
    {"id": 14, "type": "text", "title": "Accuracy evidence unavailable", "options": {"mode": "markdown", "content": "BuildIT does not publish an accuracy score until qualified reviewers finish the blind labelled release set and agreement check."}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40}}
  ]
}
